@model int
@{
    bool invalidFile = ViewData.ModelState.TryGetValue("file", out var fileState) && fileState.Errors.Count > 0;
}

<form asp-action="Upload" asp-route-id="@Model" method="post" enctype="multipart/form-data" data-file-picker>
    <label for="file">Yüklenecek Ek-16 dosyası</label>
    <input id="file" name="file" type="file" accept=".doc,.docx,.pdf,.jpg,.jpeg,.png"
           aria-describedby="upload-help upload-error upload-selection" aria-invalid="@(invalidFile ? "true" : null)" required />
    <p id="upload-selection" role="status" data-file-selection hidden></p>
    <div class="actions"><button type="submit">Evrak Yükle</button></div>
</form>
