@using StajEvrakSistemi.Services
@model StajEvrakSistemi.Web.AdminDashboard
@{
    ViewData["Title"] = "Yönetici Paneli";
    var heading = Model.Completed ? "Tamamlanan başvurular" : "Tüm başvurular";
}

<h1>Yönetici Paneli</h1>

<nav class="tabs" aria-label="Yönetici paneli sekmeleri">
    <a asp-action="Index" asp-route-completed="false" aria-current="@(!Model.Completed ? "page" : null)">Tüm başvurular</a>
    <a asp-action="Index" asp-route-completed="true" aria-current="@(Model.Completed ? "page" : null)">Tamamlandı</a>
</nav>

@if (!Model.Completed)
{
    <section class="card" aria-labelledby="dataset-heading">
        <h2 id="dataset-heading">Öğrenci veri setini yükle</h2>
        <p id="dataset-formats">CSV veya JSON, en fazla 10 MB.</p>
        <form asp-action="ImportDataset" method="post" enctype="multipart/form-data">
            <label for="dataset">Veri seti dosyası</label>
            <input id="dataset" name="dataset" type="file" accept=".csv,.json" aria-describedby="dataset-formats" required />
            <button type="submit">Veri setini yükle</button>
        </form>

        @if (Model.ImportError is { } error)
        {
            <p class="notice error" role="alert">@error</p>
        }

        @if (Model.ImportResult is { } result)
        {
            <div class="notice" role="status">
                <h3>Aktarım sonucu</h3>
                <dl>
                    <dt>Okunan kayıt</dt>
                    <dd>@result.TotalRows</dd>
                    <dt>Eklenen kayıt</dt>
                    <dd>@result.Imported</dd>
                    <dt>Dosyada tekrarlanan</dt>
                    <dd>@result.DuplicatesInFile</dd>
                    <dt>Veritabanında zaten bulunan</dt>
                    <dd>@result.DuplicatesInDatabase</dd>
                    <dt>Hatalı kayıt</dt>
                    <dd>@result.Errors.Count</dd>
                </dl>
            </div>

            @if (result.Errors.Count > 0)
            {
                <h3>Hatalı satırlar</h3>
                <ul>
                    @foreach (var row in result.Errors)
                    {
                        <li><strong>Satır @row.RowNumber</strong> · @row.Message</li>
                    }
                </ul>
            }
        }
    </section>
}

<section class="card" aria-labelledby="applications-heading">
    <h2 id="applications-heading">@heading</h2>
    @if (Model.Applications.Count == 0)
    {
        <p>@(Model.Completed ? "Henüz tamamlanan başvuru yok." : "Henüz başvuru yok.")</p>
    }
    else
    {
        <div class="table-scroll">
            <table aria-labelledby="applications-heading">
                <thead>
                    <tr>
                        <th scope="col">Başvuru no</th>
                        <th scope="col">Öğrenci kullanıcı no</th>
                        <th scope="col">İşyeri</th>
                        <th scope="col">Öğretim yılı ve yarıyıl</th>
                        <th scope="col">Staj tarihleri</th>
                        <th scope="col">Net staj günü</th>
                        <th scope="col">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model.Applications)
                    {
                        <tr>
                            <th scope="row">#@application.Id</th>
                            <td>@application.StudentId</td>
                            <td>@application.CompanyName</td>
                            <td>@application.AcademicYear @application.Semester</td>
                            <td>@application.StartDate.ToString("dd.MM.yyyy") – @application.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@application.NetWorkDays.ToString("0.##")</td>
                            <td>@StatusWorkflowEngine.GetDisplayName(application.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
