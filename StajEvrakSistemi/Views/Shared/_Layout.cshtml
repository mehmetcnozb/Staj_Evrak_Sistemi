<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Staj Evrak Sistemi</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#ana-icerik">Ana içeriğe geç</a>
    <header class="site-header">
        <div class="shell header-content">
            <a class="brand" asp-controller="Account" asp-action="Index">Staj Evrak Sistemi</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="actions" aria-label="Oturum">
                    <a asp-controller="Account" asp-action="Index">Panelim</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="secondary">Çıkış yap</button>
                    </form>
                </nav>
            }
        </div>
    </header>
    <main class="shell content" id="ana-icerik" tabindex="-1">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
