<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF6F0" data-light="#FAF6F0" data-dark="#261E1A" />
    <title>@ViewData["Title"] | Staj Evrak Sistemi</title>
    <script>
        (() => {
            let theme;
            try { theme = localStorage.getItem("staj-theme"); } catch { }
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.dataset.theme = theme;
            const color = document.querySelector('meta[name="theme-color"]');
            color.content = color.dataset[theme];
        })();
    </script>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#ana-icerik">Ana içeriğe geç</a>
    <header class="site-header">
        <div class="shell header-content">
            <a class="brand" asp-controller="Account" asp-action="Index">
                <span class="brand-mark" aria-hidden="true"></span>
                Staj Evrak Sistemi
            </a>
            <div class="actions header-actions">
                <button type="button" class="theme-toggle" aria-pressed="false" hidden>
                    <span class="theme-toggle-icon" aria-hidden="true">
                        <svg data-theme-icon="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                            <path d="M20.9 13.35A9 9 0 0 1 10.65 3.1 9 9 0 1 0 20.9 13.35Z" />
                        </svg>
                        <svg data-theme-icon="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" focusable="false" hidden>
                            <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
                        </svg>
                    </span>
                    <span class="theme-toggle-label">Koyu tema</span>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <nav class="actions header-session" aria-label="Oturum">
                        <span class="status-badge">@(User.IsInRole(RolePermissions.RoleAdmin) ? "Yönetici" : "Öğrenci")</span>
                        <a class="header-link" asp-controller="Account" asp-action="Index">Panelim</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="secondary">Çıkış yap</button>
                        </form>
                    </nav>
                }
            </div>
        </div>
    </header>
    <main class="shell content" id="ana-icerik" tabindex="-1">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
