@model LoginInput
@{
    ViewData["Title"] = "Giriş yap";
}
<div class="login-layout">
    <div class="login-intro">
        <div>
            <p class="login-intro-title">Staj başvurunu tek yerden takip et.</p>
            <p class="login-intro-caption">Ek-16 belgeni yükle, inceleme sonucunu gör.</p>
        </div>
    </div>
    <section class="card account-card login-card" aria-labelledby="login-heading">
        <h1 id="login-heading">Giriş yap</h1>
        @if (TempData["AccountMessage"] is string message)
        {
            <p class="notice success" role="status">@message</p>
        }
        <form asp-action="Login" method="post" class="form-grid">
            <div asp-validation-summary="ModelOnly" role="alert" class="full-width"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="full-width">
                <label asp-for="Identifier"></label>
                <input asp-for="Identifier" autocomplete="username" required />
                <span asp-validation-for="Identifier"></span>
            </div>
            <div class="full-width">
                <label asp-for="Password"></label>
                <div class="password-field">
                    <input asp-for="Password" autocomplete="current-password" required />
                    <button type="button" class="button quiet password-toggle" data-password-toggle
                            aria-controls="Password" aria-label="Şifreyi göster" hidden>Göster</button>
                </div>
                <span asp-validation-for="Password"></span>
            </div>
            <div class="account-actions full-width">
                <button type="submit">Giriş yap</button>
                <a asp-action="Register">Öğrenci hesabı oluştur</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
