@model ApplicationReport
@{
    var application = Model.Application;
    var document = Model.Document;
    var admin = User.IsInRole(RolePermissions.RoleAdmin);
    ViewData["Title"] = $"Başvuru #{application.Id} hata raporu";
}

<p>
    @if (admin)
    {
        <a asp-controller="Admin" asp-action="Index" asp-route-completed="@(application.Status == ApplicationStatus.Completed)">Yönetici paneline dön</a>
    }
    else
    {
        <a asp-controller="Student" asp-action="Details" asp-route-id="@application.Id">Başvuruya dön</a>
    }
</p>
<h1>Başvuru #@application.Id · Ek-16 hata raporu</h1>

@if (TempData["ReportNotice"] is string notice)
{
    <p class="notice success" role="status">@notice</p>
}
@if (TempData["ReportError"] is string error)
{
    <p class="notice error" role="alert">@error</p>
}

<section class="card">
    <h2>Başvuru bilgileri</h2>
    <dl class="form-grid">
        <div><dt>Öğrenci</dt><dd>@Model.StudentName</dd></div>
        <div><dt>İşyeri</dt><dd>@application.CompanyName</dd></div>
        <div><dt>Durum</dt><dd>@StatusWorkflowEngine.GetDisplayName(application.Status)</dd></div>
        <div><dt>Net staj günü</dt><dd>@application.NetWorkDays.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</dd></div>
    </dl>
</section>

<section class="card">
    <h2>Son yüklenen belgenin kontrol sonucu</h2>
    @if (document is null)
    {
        <p>Henüz Ek-16 belgesi yüklenmedi.</p>
    }
    else
    {
        <p>Ek-16 #@document.Id · @document.FileFormat.ToUpperInvariant() · @InternshipDateValidator.ToTurkeyDate(document.UploadedAt).ToString("dd.MM.yyyy")</p>
        @if (admin)
        {
            <p><a asp-action="Download" asp-route-id="@application.Id">Son Ek-16 belgesini indir</a></p>
        }
        @if (document.RejectionReason is { } issues)
        {
            <div class="notice error">
                <h3>Hatalı veya eksik alanlar</h3>
                <ul>
                    @foreach (var issue in issues.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
        }
        else if (document.ApprovalReviewedAt is not null && application.Ek16Verified)
        {
            <p class="notice success">Kontrol edilen alanlarda eksik veya uyumsuz bilgi bulunmadı.</p>
        }
        else
        {
            <p>Bu belge için inceleme sonucu bekleniyor.</p>
        }
    }
</section>

@if (admin && document is not null && application.Status == ApplicationStatus.UnderReview)
{
    <partial name="_ReviewForm" model="Model" />
}

@if (admin && document is not null && application.Status is ApplicationStatus.Uploaded or ApplicationStatus.UnderReview or ApplicationStatus.Approved)
{
    <section class="card">
        <h2>Başvuru işlemleri</h2>
        @if (application.Status == ApplicationStatus.Uploaded)
        {
            <form asp-action="UpdateStatus" asp-route-id="@application.Id" method="post">
                <button type="submit" name="target" value="UnderReview">İncelemeyi başlat</button>
            </form>
        }
        @if (application.Status == ApplicationStatus.UnderReview)
        {
            <form asp-action="UpdateStatus" asp-route-id="@application.Id" method="post">
                <label for="note">Hatalı / eksik gerekçesi</label>
                <textarea name="note" id="note" rows="3" maxlength="500" required></textarea>
                <div class="actions"><button type="submit" name="target" value="FaultyOrMissing">Düzeltme iste</button></div>
            </form>
        }
        @if (application.Status == ApplicationStatus.UnderReview && document.ApprovalReviewedAt is not null
            && document.RejectionReason is null && application.Ek16Verified)
        {
            <form asp-action="UpdateStatus" asp-route-id="@application.Id" method="post">
                <div class="actions"><button type="submit" name="target" value="Approved">Onayla ve tamamla</button></div>
            </form>
        }
        @if (application.Status == ApplicationStatus.Approved)
        {
            <form asp-action="UpdateStatus" asp-route-id="@application.Id" method="post">
                <button type="submit" name="target" value="Completed">Tamamla</button>
            </form>
        }
    </section>
}

@if (Model.History.Count > 0)
{
    <section class="card">
        <h2>Durum geçmişi</h2>
        <ol>
            @foreach (var entry in Model.History.Reverse())
            {
                <li>
                    <strong>@StatusWorkflowEngine.GetDisplayName(entry.NewStatus)</strong>
                    · @InternshipDateValidator.ToTurkeyDate(entry.ChangedAt).ToString("dd.MM.yyyy")
                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                    {
                        <div>@entry.Note</div>
                    }
                </li>
            }
        </ol>
    </section>
}
