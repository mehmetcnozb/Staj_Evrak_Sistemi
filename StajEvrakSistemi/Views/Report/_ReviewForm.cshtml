@model ApplicationReport
@{
    var fields = Model.ReadFields!;
    var turkey = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    (string Label, string? Value)[] entries = [
        ("Ad soyad", fields.FullName), ("Öğrenci numarası", fields.StudentNumber),
        ("Kimlik numarası", fields.IdentityNumber), ("Bölüm", fields.Department),
        ("Öğretim yılı", fields.AcademicYear), ("Yarıyıl", fields.Semester),
        ("Staj başlangıcı", fields.StartDate?.ToString("dd.MM.yyyy")),
        ("Staj bitişi", fields.EndDate?.ToString("dd.MM.yyyy")),
        ("Staj günü", fields.DeclaredWorkDays?.ToString("0.##", turkey)),
        ("İşyeri adı", fields.CompanyName), ("Mühendis sayısı", fields.EngineerCount?.ToString()),
        ("İkametgâh adresi", fields.Address), ("Telefon", fields.Phone), ("E-posta", fields.Email),
        ("Faks", fields.Fax), ("Doğum tarihi", fields.BirthDate?.ToString("dd.MM.yyyy")),
        ("Önceki staj günü", fields.PreviousInternshipDays?.ToString()), ("Sağlık yardımı statüsü", fields.HealthAidStatus), ("Çalışma günleri", fields.WorkDays is null ? null
            : string.Join(", ", fields.WorkDays.Select(turkey.DateTimeFormat.GetDayName)))
    ];
}
<section class="card">
    <h2>Ek-16 belgesinden okunan alanlar</h2>
    @if (Model.ReadError is { } error)
    {
        <p class="notice error">@error</p>
    }
    else
    {
        <dl class="details-grid">
            @foreach (var (label, value) in entries)
            {
                <div><dt>@label</dt><dd>@(value ?? "—")</dd></div>
            }
        </dl>
    }
    <form asp-action="Review" asp-route-id="@Model.Application.Id" method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="Review.DocumentId" type="hidden" />
        <fieldset>
            <legend>Onay ve imza alanları</legend>
            <div class="form-grid">
                <label>Öğrenci onay alanı
                    <select asp-for="Review.StudentApprovalPresent">
                        <option value="">İncelenmedi</option><option value="false">Boş</option><option value="true">Dolu</option>
                    </select>
                </label>
                <label>Danışman onay alanı
                    <select asp-for="Review.AdvisorApprovalPresent">
                        <option value="">İncelenmedi</option><option value="false">Boş</option><option value="true">Dolu</option>
                    </select>
                </label>
                <label>İşveren bölümü
                    <select asp-for="Review.EmployerFieldsComplete">
                        <option value="">İncelenmedi</option><option value="false">Eksik</option><option value="true">Tam</option>
                    </select>
                </label>
                <label>İşveren kaşesi
                    <select asp-for="Review.EmployerStampPresent">
                        <option value="">İncelenmedi</option><option value="false">Yok</option><option value="true">Var</option>
                    </select>
                </label>
                <label>İşveren imzası
                    <select asp-for="Review.EmployerSignaturePresent">
                        <option value="">İncelenmedi</option><option value="false">Yok</option><option value="true">Var</option>
                    </select>
                </label>
            </div>
        </fieldset>
        <button type="submit">Form ve veri setiyle karşılaştır</button>
    </form>
</section>
